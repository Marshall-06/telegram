{
  "name": "investment-bot",
  "version": "0.1.0",
  "description": "Telegram yatirim yonetimi botu - tasınabilir Node.js backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "check:telegram": "tsx scripts/check-telegram.ts",
    "restart": "powershell -ExecutionPolicy Bypass -File scripts/restart-bot.ps1",
    "setup": "npm install && prisma generate && prisma db push && npm run build && npm run check:telegram"
  },
  "keywords": [
    "telegram",
    "investment",
    "webmoney"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "grammy": "^1.46.0",
    "https-proxy-agent": "^8.0.0",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
