# Telegram
BOT_TOKEN=your_telegram_bot_token
BOT_WEBHOOK_SECRET=optional_webhook_secret

# Uygulama
NODE_ENV=development
LOG_LEVEL=info

# Veritabani (yerel: sqlite, sunucu: postgresql)
DATABASE_URL=file:./data/dev.db

# Is kurallari
MIN_DEPOSIT=10
MIN_WITHDRAW=10
WITHDRAW_DAYS=1,15
WITHDRAW_NOTIFY_HOUR=9
ADMIN_TELEGRAM_IDS=123456789
MONTHLY_PROFIT_RATE=5
DEFAULT_CURRENCY=USDT
WALLET_NETWORK=BEP20
MASTER_TRUST_WALLET=0xBCdDb4bFC8AC2eccb5E307DFFCb165408582E43f

# WebMoney (opsiyonel, ileride)
WM_WMID=
WM_PURSE=
WM_KEY_PATH=

# Ag engeli varsa proxy (opsiyonel)
# TELEGRAM_PROXY=http://127.0.0.1:7890
